# KB Agent — Environment Variables
# Copy to .env and fill in real values

# Shared bearer token for webhook machine routes (/submit) + MCP. Required off loopback.
KB_API_TOKEN=

# Cloudflare Access — browser auth for the dashboard + its forms.
# CF_ACCESS_TEAM is the Zero Trust team subdomain (the <team> in
# https://<team>.cloudflareaccess.com, e.g. the hostname in the Access login redirect).
# CF_ACCESS_AUD is the Access application's "Application Audience (AUD) Tag" (a UUID).
# Both empty => the browser path fails closed (dashboard + forms reject without a valid JWT).
CF_ACCESS_TEAM=
CF_ACCESS_AUD=

# LLM API Keys
DEEPSEEK_API_KEY=
EDGEE_API_KEY=
OPENROUTER_API_KEY=

# Object storage (S3-compatible via mc)
STORAGE_ALIAS=tigris
STORAGE_BUCKET=kb-knowledge-base

# Obsidian vault root (Seven74AI/obsidian-vault on the VPS). Overrides config.yaml.
# KB_VAULT_PATH=/root/obsidian-vault
# OBSIDIAN_VAULT_PATH=/root/obsidian-vault

# Concurrency overrides (optional)
# KB_VIDEO_SEMAPHORE=1
# KB_TEXT_PARALLEL=3
# KB_MAX_RETRIES=5

# Webhook port (optional)
# KB_WEBHOOK_PORT=5000
