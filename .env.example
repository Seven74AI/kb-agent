# KB Agent — Environment Variables
# Copy to .env and fill in real values

# LLM API Keys
DEEPSEEK_API_KEY=
EDGEE_API_KEY=

# MinIO (Tailscale-only)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Concurrency overrides (optional)
# KB_VIDEO_SEMAPHORE=1
# KB_TEXT_PARALLEL=3
# KB_MAX_RETRIES=5

# Webhook port (optional)
# KB_WEBHOOK_PORT=5000
