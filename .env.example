# KB Agent — Environment Variables
# Copy to .env and fill in real values

# Shared bearer token for webhook + MCP (mutating routes and /dashboard). Required off loopback.
KB_API_TOKEN=

# LLM API Keys
DEEPSEEK_API_KEY=
EDGEE_API_KEY=
OPENROUTER_API_KEY=

# MinIO (Tailscale-only)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Obsidian vault root (Seven74AI/obsidian-vault on the VPS). Overrides config.yaml.
# KB_VAULT_PATH=/root/obsidian-vault
# OBSIDIAN_VAULT_PATH=/root/obsidian-vault

# Concurrency overrides (optional)
# KB_VIDEO_SEMAPHORE=1
# KB_TEXT_PARALLEL=3
# KB_MAX_RETRIES=5

# Webhook port (optional)
# KB_WEBHOOK_PORT=5000
